-- 1
SELECT name,hire_date
FROM Employees
WHERE YEAR(hire_date)=2024;

-- 2
SELECT name FROM Customers WHERE name LIKE 'A%' OR name LIKE 'E%'OR name LIKE 'I%'OR name LIKE 'O%'OR name LIKE 'U%';

-- 3
SELECT * FROM Orders WHERE DAYOFWEEK(order_date) IN (1,7);

-- 4
SELECT name,salary FROM Employees WHERE salary % 1000 =0;

-- 5
SELECT COUNT(*) FROM Orders GROUP BY cust_id HAVING COUNT(*) =2;

-- 6
SELECT dept_id,AVG(salary) AS avg_sal FROM Employees GROUP BY dept_id HAVING AVG(salary) > (SELECT AVG(salary) FROM Employees);

-- 7
SELECT DAYNAME(order_date) as week ,SUM(amount) as totl_rev FROM Orders GROUP BY DAYNAME(order_date);

-- 8
SELECT
    CASE
        WHEN amount < 200 THEN 'Low'
        WHEN amount BETWEEN 200 AND 500 THEN 'Medium'
        ELSE 'High'
    END AS amount_category,
    COUNT(*) AS order_count
FROM Orders
GROUP BY
    CASE
        WHEN amount < 200 THEN 'Low'
        WHEN amount BETWEEN 200 AND 500 THEN 'Medium'
        ELSE 'High'
    END;
    
-- 9
SELECT d.dept_id,d.dept_name,COUNT(e.id)
FROM Employees e
LEFT JOIN Departments d
ON d.dept_id=e.dept_id
GROUP BY d.dept_id;

-- 10
SELECT DISTINCT e1.id, e1.name, e1.salary
FROM Employees e1
JOIN Employees e2
    ON e1.salary = e2.salary
   AND e1.id <> e2.id;
   
-- 11
SELECT * FROM Products p
WHERE p.price > (
    SELECT AVG(p2.price)
    FROM Products p2
    WHERE p2.category = p.category
);

-- 12
SELECT * FROM Orders o
WHERE o.amount>(
SELECT AVG(o2.amount) FROM Orders o2
WHERE o2.cust_id=o.cust_id);

-- 13
SELECT * FROM Employees
WHERE salary>=0.9*(
SELECT MAX(salary) FROM Employees);

-- 14
SELECT * FROM Orders o
 WHERE o.order_date = (
 SELECT MAX(order_date) FROM Orders o2 
 WHERE o2.cust_id=o.cust_id);
 
 -- 15
SELECT * ,DENSE_RANK() OVER (ORDER BY price DESC) AS rnk FROM Products;

-- 16
SELECT * FROM (
    SELECT * ,DENSE_RANK() OVER (
               PARTITION BY dept_id
               ORDER BY salary DESC
           ) AS salary_rank
    FROM Employees
) x
WHERE salary_rank = 2;

-- 17
SELECT
    p.category,
    SUM(o.amount) AS category_revenue,
    ROUND(
        100 * SUM(o.amount) / SUM(SUM(o.amount)) OVER (),
        2
    ) AS percentage_of_total
FROM Orders o
JOIN Products p
    ON o.product_id = p.id
GROUP BY p.category;

-- 17
ALTER TABLE Orders ADD (product_id INT,FOREIGN KEY (product_id) REFERENCES Products(id));

-- 18
SELECT *,COUNT(*) OVER (ORDER BY hire_date) AS cumulative_headcount
FROM Employees
ORDER BY hire_date;

-- 19
SELECT c.id,
       c.name
FROM Customers c
WHERE EXISTS (
    SELECT 1
    FROM Orders o
    WHERE o.cust_id = c.id
)
AND NOT EXISTS (
    SELECT 1
    FROM Orders o
    WHERE o.cust_id = c.id
      AND o.order_date >= CURDATE() - INTERVAL 90 DAY
);

-- 20
SELECT cust_id,
       AVG(days_between_orders) AS avg_days_between_orders
FROM (
    SELECT cust_id,
           order_date,
           DATEDIFF(
               order_date,
               LAG(order_date) OVER (
                   PARTITION BY cust_id
                   ORDER BY order_date
               )
           ) AS days_between_orders
    FROM Orders
) x
WHERE days_between_orders IS NOT NULL
GROUP BY cust_id;


