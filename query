-- 36
WITH monthly AS (
    SELECT
        DATE_FORMAT(order_date, '%Y-%m') AS month,
        SUM(amount) AS revenue
    FROM Orders
    GROUP BY DATE_FORMAT(order_date, '%Y-%m')
)
SELECT
    month,
    revenue,
    LAG(revenue) OVER (
        ORDER BY month
    ) AS previous_month_revenue
FROM monthly;

-- 37
WITH monthly AS (
    SELECT
        DATE_FORMAT(order_date, '%Y-%m') AS month,
        SUM(amount) AS revenue
    FROM Orders
    GROUP BY DATE_FORMAT(order_date, '%Y-%m')
),
previous AS (
    SELECT
        month,
        revenue,
        LAG(revenue) OVER (ORDER BY month) AS previous_revenue
    FROM monthly
)
SELECT
    month,
    revenue,
    previous_revenue,
    ((revenue - previous_revenue) / previous_revenue) * 100
        AS growth_percentage
FROM previous;

-- 38
WITH ranked AS (
    SELECT
        name,
        dept_id,
        salary,
        RANK() OVER (
            PARTITION BY dept_id
            ORDER BY salary DESC
        ) AS rnk
    FROM Employees
)
SELECT
    name,
    dept_id,
    salary
FROM ranked
WHERE rnk = 1;

-- 39
WITH order_days AS (
    SELECT DISTINCT
        cust_id,
        order_date
    FROM Orders
),
numbered AS (
    SELECT
        cust_id,
        order_date,
        ROW_NUMBER() OVER (
            PARTITION BY cust_id
            ORDER BY order_date
        ) AS rn
    FROM order_days
),
grouped AS (
    SELECT
        cust_id,
        order_date,
        DATE_SUB(order_date, INTERVAL rn DAY) AS grp
    FROM numbered
)
SELECT
    cust_id,
    COUNT(*) AS consecutive_days
FROM grouped
GROUP BY cust_id, grp
HAVING COUNT(*) >= 3;

-- 40
WITH ranked AS (
    SELECT
        dept_id,
        salary,
        ROW_NUMBER() OVER (
            PARTITION BY dept_id
            ORDER BY salary
        ) AS rn,
        COUNT(*) OVER (
            PARTITION BY dept_id
        ) AS cnt
    FROM Employees
)
SELECT
    dept_id,
    AVG(salary) AS median_salary
FROM ranked
WHERE rn IN (
    FLOOR((cnt + 1) / 2),
    CEIL((cnt + 1) / 2)
)
GROUP BY dept_id;

